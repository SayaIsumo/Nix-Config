/* Catppuccin Mocha, lavender accent. Layout mirrors the old wofi style.css */
* {
    accent:     #b4befe; /* lavender */
    txt:        #cdd6f4; /* text */
    bg:         #1e1e2e; /* base */
    bg2:        #45475a; /* surface1 */

    background-color: transparent;
    text-color:       @txt;
    font:             "JetBrainsMono Nerd Font 13";
}

window {
    width:            750px;
    height:           400px;
    padding:          10px;
    border:           3px;
    border-color:     @accent;
    border-radius:    7px;
    background-color: @bg;
}

mainbox {
    spacing:  10px;
    children: [ inputbar, listview ];
}

inputbar {
    padding:          10px;
    border-radius:    5px;
    background-color: @bg2;
    text-color:       @accent;
    children:         [ prompt, entry ];
    spacing:          10px;
}

prompt, entry {
    text-color: inherit;
}

entry {
    placeholder:       "Hmm, what do you want to run?";
    placeholder-color: @txt;
}

listview {
    scrollbar: false;
    spacing:   4px;
}

element {
    padding:       8px 10px;
    border-radius: 5px;
    spacing:       10px;
}

element selected {
    background-color: @accent;
    text-color:       @bg;
}

element-icon {
    size: 24px;
}

element-text {
    text-color:     inherit;
    vertical-align: 0.5;
}
